APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/careeros.db
DATA_DIR=./data
EXPORT_DIR=./exports
LOG_LEVEL=INFO
SCHEDULER_ENABLED=false
MODEL_PROVIDER=disabled
MODEL_DAILY_BUDGET_USD=0
MODEL_MONTHLY_BUDGET_USD=0
