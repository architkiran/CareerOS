APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/careeros.db
DATA_DIR=./data
EXPORT_DIR=./exports
LOG_LEVEL=INFO
# Normal workflow: source monitor defaults to 30 minutes; change/pause in Settings.
# A saved monitoring preference takes precedence over this first-run default.
DISCOVERY_MONITOR_ENABLED=true
# Optional legacy schedules; leave disabled to avoid additional scheduled work.
SCHEDULER_ENABLED=false
MISSION_SCHEDULER_ENABLED=false
MODEL_PROVIDER=disabled
MODEL_DAILY_BUDGET_USD=0
MODEL_MONTHLY_BUDGET_USD=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
DISPLAY_TIMEZONE=America/New_York
# Only for the optional legacy/full-review schedules above.
# The normal monitor uses its saved minute interval and stricter provider limits.
SCHEDULE_INTERVAL_HOURS=24
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
MODEL_TIMEOUT_SECONDS=60
ALLOW_REMOTE=false
BACKUP_DIR=./backups

# Optional native local rewrite service; see docs/LOCAL_REWRITES.md
LLAMA_BASE_URL=http://127.0.0.1:11435
LLAMA_MODEL=qwen3-4b.gguf
LLAMA_KEY_FILE=.tools/local-model.key
